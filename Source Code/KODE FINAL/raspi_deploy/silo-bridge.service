[Unit]
Description=Silo QR Vision + ESP32 UART + MQTT Bridge
After=network.target mosquitto.service silo-api.service
Wants=network.target

[Service]
Type=simple
User=kelompok2
WorkingDirectory=/home/kelompok2/Silo_ESP_RASPI
ExecStartPre=-/usr/bin/v4l2-ctl -d /dev/video0 --set-ctrl=focus_automatic_continuous=0
ExecStartPre=-/usr/bin/v4l2-ctl -d /dev/video0 --set-ctrl=focus_absolute=301,brightness=4,contrast=13,sharpness=11
ExecStart=/usr/bin/python3 -u /home/kelompok2/Silo_ESP_RASPI/raspi_qr_bridge.py --cam 0 --width 640 --height 360 --fps 30 --port /dev/serial0 --focus 75 --boost 0 --mqtt-host 127.0.0.1 --mqtt-port 1883
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
